# ==============================================================================
# UYCHI PARRANDA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Ushbu fayldan nusxa olib, '.env' nomiga o'zgartiring va o'z parametrlaringizni kiriting.
# Diqqat: .env faylini hech qachon GitHub'ga yuklamang!

# ------------------------------------------------------------------------------
# 1. SERVER & FLASK ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=5000
FLASK_ENV=production
SECRET_KEY=uychi-parranda-super-secret-key-2026

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL / SQLITE)
# ------------------------------------------------------------------------------
# A) Agar tayyor to'liq ulanish URL bo'lsa (Railway, Neon, Supabase va h.k.):
DATABASE_URL=postgresql://postgres:parol@localhost:5432/uychi_parranda

# B) Agar alohida parametrlardan foydalanmoqchi bo'lsangiz (DATABASE_URL bo'sh bo'lganda ishlaydi):
DB_USER=postgres
DB_PASSWORD=parol
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uychi_parranda

# (Eslatma: Agar yuqoridagi barcha baza sozlamalari bo'sh qoldirilsa, lokal sqlite:///uychi_parranda.db ishlaydi)

# ------------------------------------------------------------------------------
# 3. WEB PUSH NOTIFICATIONS (VAPID)
