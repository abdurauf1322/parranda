<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UYCHI PARRANDA"
        android:textColor="#F59E0B"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alohida Android Notification Qabul Qiluvchi"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Backend Server URL:"
        android:textColor="#CBD5E1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etBackendUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:hint="https://parranda-production.up.railway.app"
        android:textColorHint="#64748B" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Foydalanuvchi nomi (Username):"
        android:textColor="#CBD5E1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:hint="masalan: abdulaziz_raximjonov"
        android:textColorHint="#64748B" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xodim Vazifasi (Roli):"
        android:textColor="#CBD5E1"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerRole"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E293B"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSaveAndSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saqlash va Ulanish"
        android:backgroundTint="#F59E0B"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnTestNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sinov Bildirishnomasi"
        android:backgroundTint="#334155"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvTokenStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FCM Token kutilmoqda..."
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
