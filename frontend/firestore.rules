rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Path variable guard (Pillar 3: ID Poisoning Guard)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }

    // Entity Validation Helpers
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 200 &&
             data.role is string && data.role.size() <= 50 &&
             (!('branchId' in data) || (data.branchId is string && data.branchId.size() <= 64)) &&
             (!('branchName' in data) || (data.branchName is string && data.branchName.size() <= 200));
    }

    function isValidPersonalNote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.content is string && data.content.size() <= 5000;
    }

    function isValidAttendance(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 200 &&
             data.role is string && data.role.size() <= 50 &&
             data.date is string && data.date.size() <= 20 &&
             data.checkInTime is string && data.checkInTime.size() <= 20 &&
             data.status in ['keldi', 'kechikdi', 'orinbosar_bilan', 'chiqib_ketdi'];
    }

    function isValidFarmTask(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.assignedByName is string && data.assignedByName.size() <= 200 &&
             data.assignedToRole is string && data.assignedToRole.size() <= 50 &&
             data.status in ['yangi', 'jarayonda', 'bajarildi', 'tasdiqlandi', 'rad_etildi'];
    }

    function isValidSlesarMilestone(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.time is string && data.time.size() <= 20 &&
             data.alertTime is string && data.alertTime.size() <= 20 &&
             data.title is string && data.title.size() <= 300 &&
             data.status in ['kutilmoqda', 'ogohlantirildi', 'bajarildi', 'otkazildi'];
    }

    function isValidPhotoReport(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.uploaderName is string && data.uploaderName.size() <= 200 &&
             data.title is string && data.title.size() <= 500 &&
             data.imageUrl is string && data.imageUrl.size() <= 950000 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             (!('uploaderId' in data) || (data.uploaderId is string && data.uploaderId.size() <= 128)) &&
             (!('uploaderRole' in data) || (data.uploaderRole is string && data.uploaderRole.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000)) &&
             (!('building' in data) || (data.building is string && data.building.size() <= 200)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('verifiedBy' in data) || (data.verifiedBy is string && data.verifiedBy.size() <= 200)) &&
             (!('verifiedAt' in data) || (data.verifiedAt is string && data.verifiedAt.size() <= 64));
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 200 &&
             data.message is string && data.message.size() <= 6000 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             (!('attachmentType' in data) || (data.attachmentType in ['image', 'video', 'audio', 'file'])) &&
             (!('senderBranch' in data) || (data.senderBranch is string && data.senderBranch.size() <= 200));
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // 2. Personal notes (Zametkalar)
    match /personal_notes/{noteId} {
      allow get: if isValidId(noteId);
      allow list: if true;
      allow create, update: if isValidId(noteId) && isValidPersonalNote(incoming());
      allow delete: if isValidId(noteId);
    }

    // 3. Attendance collection
    match /attendance/{attendanceId} {
      allow get: if isValidId(attendanceId);
      allow list: if true;
      allow create, update: if isValidId(attendanceId) && isValidAttendance(incoming());
      allow delete: if isValidId(attendanceId);
    }

    // 4. Tasks collection
    match /tasks/{taskId} {
      allow get: if isValidId(taskId);
      allow list: if true;
      allow create, update: if isValidId(taskId) && isValidFarmTask(incoming());
      allow delete: if isValidId(taskId);
    }

    // 5. Slesar milestones
    match /slesar_milestones/{milestoneId} {
      allow get: if isValidId(milestoneId);
      allow list: if true;
      allow create, update: if isValidId(milestoneId) && isValidSlesarMilestone(incoming());
      allow delete: if isValidId(milestoneId);
    }

    // 6. Photo reports
    match /photo_reports/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if true;
      allow create, update: if isValidId(reportId) && isValidPhotoReport(incoming());
      allow delete: if isValidId(reportId);
    }

    // 7. Corporate chat messages
    match /chat_messages/{messageId} {
      allow get: if isValidId(messageId);
      allow list: if true;
      allow create: if isValidId(messageId) && isValidChatMessage(incoming());
      allow update, delete: if isValidId(messageId);
    }

    // 8. Factory daily reports
    match /factory_reports/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if true;
      allow write: if isValidId(reportId);
    }

    // 9. Veterinary diagnoses
    match /diagnoses/{diagnosisId} {
      allow get: if isValidId(diagnosisId);
      allow list: if true;
      allow write: if isValidId(diagnosisId);
    }

    // 10. Electricity logs
    match /electricity_logs/{logId} {
      allow get: if isValidId(logId);
      allow list: if true;
      allow write: if isValidId(logId);
    }

    // 11. Egg transport logs
    match /egg_transports/{transportId} {
      allow get: if isValidId(transportId);
      allow list: if true;
      allow write: if isValidId(transportId);
    }

    // 12. Feed transport logs
    match /feed_transports/{transportId} {
      allow get: if isValidId(transportId);
      allow list: if true;
      allow write: if isValidId(transportId);
    }

    // 13. Guard shift logs
    match /guard_shifts/{shiftId} {
      allow get: if isValidId(shiftId);
      allow list: if true;
      allow write: if isValidId(shiftId);
    }

    // 14. Kitchen grocery requests
    match /grocery_requests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if true;
      allow write: if isValidId(requestId);
    }

    // 15. Sanitation tasks
    match /sanitation_tasks/{taskId} {
      allow get: if isValidId(taskId);
      allow list: if true;
      allow write: if isValidId(taskId);
    }

    // 16. Operational plans
    match /operational_plans/{planId} {
      allow get: if isValidId(planId);
      allow list: if true;
      allow write: if isValidId(planId);
    }

    // 17. Chicken weights
    match /chicken_weights/{weightId} {
      allow get: if isValidId(weightId);
      allow list: if true;
      allow write: if isValidId(weightId);
    }

    // 18. Audit logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId);
      allow list: if true;
      allow write: if isValidId(logId);
    }
  }
}
